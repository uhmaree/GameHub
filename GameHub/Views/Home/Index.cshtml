@{
    ViewData["Title"] = "Home";
}
<div class="hero p-5 mb-4 text-center">
    <h1 class="display-5">Welcome to GameHub</h1>
    <p class="lead">.</p>
    <a class="btn btn-light btn-lg" asp-controller="Games" asp-action="Index">Browse My Games</a>
</div>

<div class="row g-3">
    <div class="col-md-4">
        <div class="card h-100"><div class="card-body">
            <h5 class="card-title">About</h5>
            <p class="card-text">.</p>
            <a asp-controller="Home" asp-action="Hobby">Read more</a>
        </div></div>
    </div>
    <div class="col-md-4">
        <div class="card h-100"><div class="card-body">
            <h5 class="card-title">My Games</h5>
            <p class="card-text">Our collection.</p>
            <a asp-controller="Games" asp-action="Index">View games</a>
        </div></div>
    </div>
    <div class="col-md-4">
        <div class="card h-100"><div class="card-body">
            <h5 class="card-title">About Us</h5>
            <p class="card-text">Team</p>
            <a asp-controller="About" asp-action="Index">Meet the team</a>
        </div></div>
    </div>
</div>
