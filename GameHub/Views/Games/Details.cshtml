@model Game
@{
    ViewData["Title"] = Model.Title;
}
<h1>@Model.Title</h1>
<dl class="row">
    <dt class="col-sm-2">Genre</dt><dd class="col-sm-10">@Model.Genre.Name</dd>
    <dt class="col-sm-2">Platform</dt><dd class="col-sm-10">@Model.Platform</dd>
    <dt class="col-sm-2">Released</dt><dd class="col-sm-10">@Model.ReleaseYear</dd>
    <dt class="col-sm-2">Hours played</dt><dd class="col-sm-10">@Model.HoursPlayed</dd>
    <dt class="col-sm-2">Rating</dt><dd class="col-sm-10">@Model.Rating / 10</dd>
    <dt class="col-sm-2">Notes</dt><dd class="col-sm-10">@Model.Notes</dd>
</dl>
<a class="btn btn-outline-secondary" asp-action="Index">Back to games</a>
