@model GamesIndexViewModel
@{
    ViewData["Title"] = "My Games";
}
<h1>My Games</h1>

<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <select name="genreId" class="form-select"
                asp-items="@(new SelectList(Model.Genres, "GenreId", "Name", Model.SelectedGenreId))">
            <option value="">All genres</option>
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Filter</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
    </div>
</form>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Title</th>
            <th>Genre</th>
            <th>Platform</th>
            <th>Year</th>
            <th>Hours</th>
            <th>Rating</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (Game game in Model.Games)
        {
            <tr>
                <td>@game.Title</td>
                <td>@game.Genre.Name</td>
                <td>@game.Platform</td>
                <td>@game.ReleaseYear</td>
                <td>@game.HoursPlayed</td>
                <td><span class="badge bg-success">@game.Rating / 10</span></td>
                <td><a asp-action="Details" asp-route-id="@game.GameId">Details</a></td>
            </tr>
        }
    </tbody>
</table>
